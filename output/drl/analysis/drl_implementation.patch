new file mode 100644
index 0000000..347854e
--- /dev/null
+++ b/controllers/micromouse/lidar_dqn.py
@@ -0,0 +1,65 @@
+"""Continuous observations and action constraints shared by DQN runtimes."""
+import math
+
+import numpy as np
+
+from lidar_qlearning import ACTION_NAMES, ACTION_VW, STOP_ACTION, safe_actions, waypoint_bearing
+
+FEATURES = (
+    'bearing_sin', 'bearing_cos', 'target_distance_over_arena_diagonal',
+    'front', 'front_left', 'left', 'right', 'front_right',
+    'linear_speed', 'yaw_rate', 'scanning', 'collision_recovery',
+)
+NUM_ACTIONS = len(ACTION_NAMES)
+LIDAR_RANGE = 4.
+
+
+def action_mask(allowed):
+    mask = np.zeros(NUM_ACTIONS, dtype=bool)
+    mask[list(allowed)] = True
+    if not mask.any():
+        mask[STOP_ACTION] = True
+    return mask
+
+
+def get_action_mask(observation):
+    """Physical mask from the five normalized forward-sector minima."""
+    obs = np.asarray(observation)
+    if obs.shape != (len(FEATURES),) or not np.isfinite(obs).all():
+        raise ValueError('Expected one finite DQN observation.')
+    if obs[-1]:
+        return action_mask((STOP_ACTION,))
+    return action_mask(safe_actions(obs[3:8] * LIDAR_RANGE))
+
+
+def encode_observation(pose, target, sectors, wheels, config, distance_scale, *, recovering=False):
+    pose = np.asarray(pose)
+    sectors = np.asarray(sectors)
+    wheels = np.asarray(wheels)
+    if pose.shape != (3,) or sectors.shape != (5,) or wheels.shape != (2,):
+        raise ValueError('Expected 3 pose, 5 LiDAR, and 2 wheel measurements.')
+    if not all(np.isfinite(x).all() for x in (pose, sectors, wheels)):
+        raise ValueError('Nonfinite DQN sensor input.')
+    if not math.isfinite(distance_scale) or distance_scale <= 0:
+        raise ValueError('Distance scale must be finite and positive.')
+    if target is None:
+        relative = (0., 0., 0.)
+    else:
+        bearing = waypoint_bearing(pose, target)
+        relative = (math.sin(bearing), math.cos(bearing),
+                    min(1., math.dist(pose[:2], target) / distance_scale))
+    left, right = wheels / config.wheel_limit
+    result = np.array([
+        *relative, *np.clip(sectors / LIDAR_RANGE, 0., 1.),
+        np.clip((left + right) / 2, -1., 1.), np.clip((right - left) / 2, -1., 1.),
+        float(target is None), float(recovering),
+    ], dtype=np.float32)
+    if not np.isfinite(result).all():
+        raise ValueError('Nonfinite DQN observation.')
+    return result
+
+
+def schema():
+    return dict(observation=list(FEATURES),
+                actions=[dict(name=name, velocity=list(velocity))
+                         for name, velocity in zip(ACTION_NAMES, ACTION_VW)])
diff --git a/controllers/micromouse/lidar_dqn_agent.py b/controllers/micromouse/lidar_dqn_agent.py
new file mode 100644
index 0000000..934dfb0
--- /dev/null
+++ b/controllers/micromouse/lidar_dqn_agent.py
@@ -0,0 +1,116 @@
+"""Masked Double DQN updates, deterministic inference, and resume state."""
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch import nn
+
+from lidar_dqn import schema
+from lidar_dqn_network import QNetwork
+from lidar_dqn_replay import ReplayBuffer
+
+VERSION = 1
+
+
+def double_dqn_target(online_values, target_values, mask, reward, terminated, gamma):
+    """Online selects the safe action, target evaluates that same action."""
+    action = online_values.masked_fill(~mask, -torch.inf).argmax(dim=1, keepdim=True)
+    estimate = target_values.gather(1, action).squeeze(1)
+    return reward + gamma * torch.where(terminated, torch.zeros_like(estimate), estimate)
+
+
+def atomic_save(data, path):
+    path = Path(path)
+    temp = path.with_suffix(path.suffix + '.tmp')
+    torch.save(data, temp)
+    temp.replace(path)
+
+
+def read_checkpoint(path, device='cpu'):
+    saved = torch.load(path, map_location=device, weights_only=True)
+    if saved.get('version') != VERSION or saved.get('schema') != schema():
+        raise ValueError('Incompatible Double DQN checkpoint schema.')
+    return saved
+
+
+def load_inference(path):
+    saved = read_checkpoint(path)
+    network = QNetwork(saved['config']['hidden'])
+    network.load_state_dict(saved['online'])
+    return network.eval().requires_grad_(False), saved
+
+
+class DQNAgent:
+    def __init__(self, config):
+        self.config = config.copy()
+        self.device = torch.device(config['device'])
+        torch.manual_seed(config['seed'])
+        self.rng = np.random.default_rng(config['seed'])
+        self.online = QNetwork(config['hidden']).to(self.device)
+        self.target = QNetwork(config['hidden']).to(self.device)
+        self.target.load_state_dict(self.online.state_dict())
+        self.target.eval().requires_grad_(False)
+        self.optimizer = torch.optim.Adam(self.online.parameters(), lr=config['learning_rate'])
+        self.replay = ReplayBuffer(config['capacity'])
+        self.updates = self.target_updates = 0
+
+    @torch.no_grad()
+    def values(self, state):
+        return self.online(torch.as_tensor(state, device=self.device)).cpu().numpy()
+
+    def choose(self, state, mask, epsilon):
+        valid = np.flatnonzero(mask)
+        if not len(valid):
+            raise ValueError('Action mask has no fallback.')
+        if len(valid) == 1:
+            return int(valid[0])
+        if epsilon and self.rng.random() < epsilon:
+            return int(self.rng.choice(valid))
+        return int(valid[np.argmax(self.values(state)[valid])])
+
+    def update(self):
+        cfg = self.config
+        if self.replay.size < max(cfg['warmup'], cfg['batch_size']):
+            return None
+        data = self.replay.sample(cfg['batch_size'], self.rng, self.device)
+        q = self.online(data['state'])
+        chosen = q.gather(1, data['action'][:, None]).squeeze(1)
+        with torch.no_grad():
+            target = double_dqn_target(
+                self.online(data['next_state']), self.target(data['next_state']),
+                data['next_mask'], data['reward'], data['terminated'], cfg['gamma'])
+        loss = nn.functional.smooth_l1_loss(chosen, target)
+        if not torch.isfinite(loss):
+            raise FloatingPointError('Nonfinite DQN loss.')
+        self.optimizer.zero_grad(set_to_none=True)
+        loss.backward()
+        nn.utils.clip_grad_norm_(self.online.parameters(), cfg['gradient_clip'], error_if_nonfinite=True)
+        self.optimizer.step()
+        self.updates += 1
+        if self.updates % cfg['target_interval'] == 0:
+            self.target.load_state_dict(self.online.state_dict())
+            self.target_updates += 1
+        return float(loss.detach()), float(q.detach().mean()), float(q.detach().max())
+
+    def save(self, path, progress, *, full=False):
+        data = dict(version=VERSION, schema=schema(), config=self.config,
+                    online=self.online.state_dict(), target=self.target.state_dict(),
+                    optimizer=self.optimizer.state_dict(), progress=progress,
+                    updates=self.updates, target_updates=self.target_updates)
+        if full:
+            data.update(replay=self.replay.state_dict(), rng=self.rng.bit_generator.state,
+                        torch_rng=torch.random.get_rng_state())
+        atomic_save(data, path)
+
+    def resume(self, path):
+        saved = read_checkpoint(path, self.device)
+        if saved['config'] != self.config or 'replay' not in saved:
+            raise ValueError('Resume requires the full checkpoint and its original configuration.')
+        self.online.load_state_dict(saved['online'])
+        self.target.load_state_dict(saved['target'])
+        self.optimizer.load_state_dict(saved['optimizer'])
+        self.replay.load_state_dict(saved['replay'])
+        self.rng.bit_generator.state = saved['rng']
+        torch.random.set_rng_state(saved['torch_rng'].cpu())
+        self.updates, self.target_updates = saved['updates'], saved['target_updates']
+        return saved['progress']
diff --git a/controllers/micromouse/lidar_dqn_network.py b/controllers/micromouse/lidar_dqn_network.py
